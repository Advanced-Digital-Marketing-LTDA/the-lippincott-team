---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import TinaIsland from '@tinacms/astro/TinaIsland.astro';
import { Icon } from 'astro-icon/components';
import { getConfig } from '../lib/data';
import { islands } from '../lib/islands';
import { telHref } from '../lib/url';

interface Props {
	title: string;
	description: string;
	image?: string;
	noindex?: boolean;
}

const { title, description, image, noindex } = Astro.props;
const config = (await getConfig()).data?.config ?? null;

const includeGtm =
	import.meta.env.PROD &&
	(process.env.CONTEXT === undefined || process.env.CONTEXT === 'production');

---

<!doctype html>
<html lang="en">
	<head>
		{includeGtm && (
			<>
				<!-- Google Tag Manager -->
				<script is:inline>
					(function (w, d, s, l, i) {
						w[l] = w[l] || [];
						w[l].push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
						var f = d.getElementsByTagName(s)[0],
							j = d.createElement(s),
							dl = l != 'dataLayer' ? '&l=' + l : '';
						j.async = true;
						j.src = 'https://www.googletagmanager.com/gtm.js?id=' + i + dl;
						f.parentNode.insertBefore(j, f);
					})(window, document, 'script', 'dataLayer', 'GTM-WM5FTV8R');
				</script>
				<!-- End Google Tag Manager -->
			</>
		)}
		<BaseHead title={title} description={description} image={image?.trim() || config?.seo?.socialImage?.trim() || undefined} noindex={noindex} />
		{/* Per-page head additions (e.g. the homepage's LCP poster preload). */}
		<slot name="head" />
		{/* .home-v2 pages hide .reveal sections until their motion JS runs;
		    without JS they must render fully visible. */}
		<noscript><style>.home-v2 .reveal{opacity:1;transform:none}</style></noscript>
	</head>
	<body>
		{includeGtm && (
			<>
				<!-- Google Tag Manager (noscript) -->
				<noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-WM5FTV8R"
					height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
				<!-- End Google Tag Manager (noscript) -->
			</>
		)}
		<TinaIsland name="global" wrapper={islands.global.wrapper}>
			<Header config={config} />
		</TinaIsland>
		<main id="main">
			<slot />
		</main>
		<TinaIsland name="global-footer" wrapper={islands['global-footer'].wrapper}>
			<Footer config={config} />
		</TinaIsland>
		{config?.contact?.phone && (
			<>
				{/* Spacer keeps the fixed call bar from covering footer content on mobile. */}
				<div aria-hidden="true" class="h-14 lg:hidden"></div>
				{/* z-10: below the sticky header (z-20) so the open mobile menu panel paints over the bar. */}
				<a
					href={telHref(config.contact.phone)}
					class="fixed inset-x-0 bottom-0 z-10 flex h-14 items-center justify-center gap-2 bg-primary text-sm font-bold uppercase tracking-[0.1em] text-primary-foreground lg:hidden"
				>
					<Icon name="tabler:phone" class="size-5" />
					{config.contact.phone}
				</a>
				</>
			)}
			<script is:inline>
				const markHarReviewLinks = () => {
					document.querySelectorAll('a[href="/reviews/"]').forEach((link) => link.setAttribute('data-astro-reload', ''));
				};
				markHarReviewLinks();
				document.addEventListener('astro:page-load', markHarReviewLinks);

				// Browser Back/Forward to /reviews/ bypasses the data-astro-reload
				// mutation above (no anchor click fires), so ClientRouter would
				// swap in the page without the parser-time document.writeln the
				// HAR widget needs — the live feed would come back empty. window
				// survives ClientRouter swaps (the same reason the GA loader is
				// __gaLoaderBound-guarded), so a popstate listener registered on
				// any full page load stays live across pages; pushState/replaceState
				// navigations don't fire popstate, so only Back/Forward reloads.
				window.addEventListener('popstate', () => {
					if (location.pathname === '/reviews/') location.reload();
				});
			</script>
			{/* Shared Apple-style motion: masked h2 reveals + magnetic primary CTAs.
		    Everything is a no-op under prefers-reduced-motion. */}
		<script is:inline>
			if (!window.__appleMotionBound) {
				window.__appleMotionBound = true;
				let h2obs = null;
				// Active magnetic-CTA animation handles, cancelled on page swap so
				// rAF loops never outlive their (detached) buttons.
				let magneticCancels = [];
				const teardownAppleMotion = () => {
					if (h2obs) { h2obs.disconnect(); h2obs = null; }
					magneticCancels.forEach((cancel) => cancel());
					magneticCancels = [];
				};

				const initAppleMotion = () => {
					// Tina refreshes fire page-load without a preceding before-swap.
					teardownAppleMotion();
					const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
					// Section headline masked reveals (CSS shows the lines when reduced).
					if (!reduced && 'IntersectionObserver' in window) {
						h2obs = new IntersectionObserver((entries, observer) => {
							if (observer !== h2obs) return;
							entries.forEach((e) => {
								if (e.isIntersecting) { e.target.classList.add('in'); observer.unobserve(e.target); }
							});
						}, { threshold: 0.35 });
						document.querySelectorAll('.h2-mask').forEach((m) => h2obs.observe(m));
					} else {
						document.querySelectorAll('.h2-mask').forEach((m) => m.classList.add('in'));
					}

					// Magnetic primary CTAs (fine pointers only, rAF lerp).
					if (!reduced && window.matchMedia('(pointer:fine)').matches) {
						document.querySelectorAll('.btn-magnetic').forEach((btn) => {
							if (btn.dataset.magneticBound) return;
							btn.dataset.magneticBound = '1';
							let tx = 0, ty = 0, cx = 0, cy = 0, raf = null, hovering = false, active = true;
							const loop = () => {
								if (!active) return;
								cx += (tx - cx) * 0.16;
								cy += (ty - cy) * 0.16;
								btn.style.transform = 'translate(' + cx.toFixed(2) + 'px,' + cy.toFixed(2) + 'px)';
								if (hovering || Math.abs(tx - cx) > 0.2 || Math.abs(ty - cy) > 0.2) {
									raf = requestAnimationFrame(loop);
								} else {
									btn.style.transform = '';
									raf = null;
								}
							};
							const kick = () => { if (raf === null) raf = requestAnimationFrame(loop); };
							const onMove = (e) => {
								const r = btn.getBoundingClientRect();
								tx = (e.clientX - r.left - r.width / 2) * 0.22;
								ty = (e.clientY - r.top - r.height / 2) * 0.28;
								hovering = true;
								kick();
							};
							const onLeave = () => {
								tx = 0; ty = 0; hovering = false;
								kick();
							};
							btn.addEventListener('pointermove', onMove);
							btn.addEventListener('pointerleave', onLeave);
							magneticCancels.push(() => {
								active = false;
								hovering = false;
								if (raf !== null) { cancelAnimationFrame(raf); raf = null; }
								btn.removeEventListener('pointermove', onMove);
								btn.removeEventListener('pointerleave', onLeave);
								delete btn.dataset.magneticBound;
								btn.style.transform = '';
							});
						});
					}
				};

				// Re-bind after every ClientRouter swap; astro:page-load fires on
				// first load too, and before-swap drops observers tied to old DOM.
				document.addEventListener('astro:page-load', initAppleMotion);
				document.addEventListener('astro:before-swap', teardownAppleMotion);
			}
		</script>
		{/* @tinacms/bridge refreshes editable regions by swapping each
		   [data-tina-island] node's innerHTML after a CMS edit — no scripts
		   rerun and no astro:* events fire, so scroll-bound bindings (.reveal,
		   count-ups, .h2-mask, magnetic CTAs) would stay dead in the swapped
		   DOM. Watching only the island's direct children catches the bridge
		   swap (it replaces them all) while nested writes from the re-fired
		   inits themselves — carousel dots, count-up textContent — can't
		   retrigger the observer. Debounced so a rapid second swap still
		   reinitializes instead of being dropped by a cooldown. */}
		<script is:inline>
			if (!window.__tinaIslandReinitBound) {
				window.__tinaIslandReinitBound = true;
				let islandReinitTimer = null;
				const islandMo = new MutationObserver((muts) => {
					if (!muts.some((m) => m.addedNodes.length > 0 || m.removedNodes.length > 0)) return;
					clearTimeout(islandReinitTimer);
					islandReinitTimer = setTimeout(() => document.dispatchEvent(new Event('astro:page-load')), 250);
				});
				document.addEventListener('astro:page-load', () => {
					islandMo.disconnect();
					document.querySelectorAll('[data-tina-island]').forEach((el) =>
						islandMo.observe(el, { childList: true })
					);
				});
				document.addEventListener('astro:before-swap', () => {
					clearTimeout(islandReinitTimer);
					islandMo.disconnect();
				});
			}
		</script>
	<script is:inline>
		(function () {
			if (window.__externalLinkPolicyBound) return;
			window.__externalLinkPolicyBound = true;
			const originalAttrs = new WeakMap();
			const referrerPolicyToken = 'noreferrer';
			const processAnchor = (anchor) => {
				if (!(anchor instanceof HTMLAnchorElement)) return;
				if (anchor.relList.contains(referrerPolicyToken)) {
					anchor.relList.remove(referrerPolicyToken);
					if (anchor.relList.length === 0) anchor.removeAttribute('rel');
				}
				const href = anchor.getAttribute('href');
				let url;
				if (href) {
					try {
						url = new URL(href, window.location.href);
					} catch {}
				}
				const isExternal = url && (url.protocol === 'http:' || url.protocol === 'https:') && url.origin !== window.location.origin;
				if (!isExternal) {
					const original = originalAttrs.get(anchor);
					if (original) {
						if (original.target === null) anchor.removeAttribute('target');
						else anchor.setAttribute('target', original.target);
						if (original.rel === null) anchor.removeAttribute('rel');
						else anchor.setAttribute('rel', original.rel);
						originalAttrs.delete(anchor);
					}
					return;
				}
				if (anchor.getAttribute('target') === '_blank' && anchor.relList.contains('noopener')) return;
				if (!originalAttrs.has(anchor)) {
					originalAttrs.set(anchor, {
						target: anchor.getAttribute('target'),
						rel: anchor.getAttribute('rel'),
					});
				}
				anchor.target = '_blank';
				anchor.relList.add('noopener');
			};
			const processNode = (node) => {
				if (!(node instanceof Element)) return;
				if (node instanceof HTMLAnchorElement) processAnchor(node);
				node.querySelectorAll('a[href]').forEach(processAnchor);
			};
			const scanAnchors = () => document.querySelectorAll('a[href]').forEach(processAnchor);
			scanAnchors();
			document.addEventListener('astro:page-load', scanAnchors);
			const observer = new MutationObserver((mutations) => {
				mutations.forEach((mutation) => {
					if (mutation.type === 'attributes') {
						if (mutation.target instanceof HTMLAnchorElement) processAnchor(mutation.target);
						return;
					}
					mutation.addedNodes.forEach(processNode);
				});
			});
			observer.observe(document, { childList: true, subtree: true, attributes: true, attributeFilter: ['href', 'rel'] });
		})();
	</script>
	</body>
</html>
