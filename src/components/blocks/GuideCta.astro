---
import SplitHeading from '../ui/SplitHeading.astro';
import { tinaField } from '@tinacms/astro/tina-field';
import GuideActions from '../ui/GuideActions.astro';
import type { GuideCtaBlock } from '../../lib/data';

interface Props {
	data: Omit<GuideCtaBlock, '__typename'>;
	stackActions?: boolean;
}

const { data, stackActions = false } = Astro.props;
const primaryActions = (data.actions ?? []).filter((action) => action?.type !== 'link');
const secondaryActions = (data.actions ?? []).filter((action) => action?.type === 'link');
---
<section class="relative overflow-hidden bg-tile py-16 text-center text-white md:py-24" data-guide-cta>
	<div class="relative z-[2] mx-auto max-w-[1200px] px-6 md:px-12">
		{data.title && (
			<div class="h2-mask">
				<SplitHeading as="h2" text={data.title} accentClass="font-normal italic text-gold" data-tina-field={tinaField(data, 'title')} class="mx-auto max-w-[22ch] text-balance text-[clamp(2rem,3.8vw,3rem)] font-serif font-light leading-[1.1] tracking-[-0.02em] text-white" />
			</div>
		)}
		{data.description && <p data-tina-field={tinaField(data, 'description')} class="mx-auto mt-5 max-w-[56ch] text-[clamp(17px,1.6vw,21px)] text-white/85">{data.description}</p>}
		{stackActions ? (
			<div class="mt-9">
				<GuideActions actions={primaryActions} class="justify-center" />
				<GuideActions actions={secondaryActions} class="mt-5 justify-center" />
			</div>
		) : (
			<GuideActions actions={data.actions} class="mt-9 justify-center" />
		)}
	</div>
</section>
<style>
	[data-guide-cta]::after {
		content: '';
		position: absolute;
		inset: auto 0 0 0;
		height: 45%;
		background: radial-gradient(55% 90% at 50% 115%, rgba(214, 50, 60, 0.2), transparent 70%);
		pointer-events: none;
	}
</style>
