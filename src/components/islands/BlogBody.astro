---
import { mediaUrl } from '../../lib/media';
const mediaSite = Astro.site?.href ?? Astro.url.origin;
import TinaMarkdown from '@tinacms/astro/TinaMarkdown.astro';
import { tinaField } from '@tinacms/astro/tina-field';
import { getConfig, getTeamMember, listBlogs, type CmsBlog, type CmsTeam } from '../../lib/data';
import { extractToc, readingTimeMinutes } from '../../lib/article';
import { buildBlogPostingJsonLd, resolveBlogAuthor, serializeJsonLd } from '../../lib/blog-schema';
import { hasRichText } from '../../lib/rich-text';
import { safeHref } from '../../lib/url';
import FormattedDate from '../FormattedDate.astro';
import GuideActions from '../ui/GuideActions.astro';
import SplitHeading from '../ui/SplitHeading.astro';
import { mdxComponents } from '../mdx/components';
import ArticleH2 from '../mdx/ArticleH2.astro';

interface Props {
	data?: CmsBlog | null;
}

const { data } = Astro.props;
const config = (await getConfig()).data?.config ?? null;
const blogCopy = config?.blogPost ?? null;
const preferredSources = config?.preferredSources ?? null;
// Byline + author box: the post's author, else Amy (see resolveBlogAuthor).
const author = data
	? await resolveBlogAuthor<CmsTeam>(data.author, () =>
			getTeamMember('amy-lippincott-2').then((res) => res.data?.team ?? null),
		)
	: null;

const toc = extractToc(data?.body);
const minutes = readingTimeMinutes(data?.body);
const displayDate = data?.updatedDate ?? data?.pubDate ?? null;
// Label follows the field actually shown: pubDate without an updatedDate is
// "Published", not "Updated".
const dateLabel = data?.updatedDate ? 'Updated' : 'Published';
// Article body with anchored h2s for the TOC.
const articleComponents = { ...mdxComponents, h2: ArticleH2 };

// Related reads: same category first, most recent inside each tier,
// excluding this post.
const related = data
	? (await listBlogs())
		.filter((p) => p._sys.filename !== data._sys.filename)
		.sort((a, b) => {
			const catMatch = Number(b.category === data.category) - Number(a.category === data.category);
			if (catMatch !== 0) return catMatch;
			return new Date(b.pubDate ?? 0).valueOf() - new Date(a.pubDate ?? 0).valueOf();
		})
		.slice(0, 3)
	: [];

const blogJsonLd = data && buildBlogPostingJsonLd({
	title: data.title,
	description: data.description,
	pubDate: data.pubDate,
	updatedDate: data.updatedDate,
	filename: data._sys.filename,
	imageUrl: data.heroImage ? new URL(mediaUrl(data.heroImage, mediaSite), mediaSite).href : null,
	author,
	siteUrl: mediaSite,
	canonicalSite: Astro.site?.href,
	publisherName: config?.seo?.title,
});
---
{data && (
	<>
		{blogJsonLd && <script type="application/ld+json" is:inline set:html={serializeJsonLd(blogJsonLd)} />}
		<section class="pt-10 md:pt-14">
			<div class="mx-auto max-w-[1200px] px-6 md:px-12">
				<nav aria-label="Breadcrumb" class="flex flex-wrap items-center gap-2 text-[13px] text-muted-foreground">
					<a href="/" class="no-underline transition-colors hover:text-primary">Home</a>
					<span aria-hidden="true">›</span>
					<a href="/blog/" class="no-underline transition-colors hover:text-primary">Blog</a>
					<span aria-hidden="true">›</span>
					<span aria-current="page">{data.title}</span>
				</nav>
				<h1 data-tina-field={tinaField(data, 'title')} class="mt-7 max-w-[24ch] text-balance font-serif text-[clamp(2rem,4vw,3.25rem)] font-light leading-[1.1] tracking-[-0.02em] text-ink">{data.title}</h1>
				<div class="mt-6 flex flex-wrap items-center gap-x-6 gap-y-4">
					{author && (
						<div class="flex items-center gap-3">
							{author.photo && <img src={mediaUrl(author.photo, mediaSite)} alt={author.name ?? ''} width={44} height={44} class="size-11 rounded-full object-cover" />}
							<div>
								<b class="block text-sm font-semibold text-ink">{author.name}</b>
								{author.role && <span class="block text-xs text-muted-foreground">{author.role}, The Lippincott Team at eXp Realty</span>}
							</div>
						</div>
					)}
					{displayDate && (
						<span data-tina-field={tinaField(data, data.updatedDate ? 'updatedDate' : 'pubDate')} class="text-[13px] text-muted-foreground">{dateLabel} <FormattedDate date={new Date(displayDate)} /></span>
					)}
					<span class="text-[13px] text-muted-foreground">{minutes} min read</span>
				</div>
				{preferredSources?.link && mediaUrl(safeHref(preferredSources.link), mediaSite) && (
					<a
						href={mediaUrl(safeHref(preferredSources.link), mediaSite)}
						target="_blank"
						rel="noopener"
						class="mt-4 inline-flex max-w-full items-center justify-center whitespace-normal break-words rounded-full border border-border bg-transparent px-5 py-2.5 text-center text-sm font-medium text-ink transition-colors hover:bg-section focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
					>
						{preferredSources.label ?? 'Add to Preferred Sources'}
					</a>
				)}
			</div>
		</section>
		<section class="py-12 md:py-16">
			<div class="mx-auto max-w-[1200px] px-6 md:px-12">
				{data.description && (
					<div data-tina-field={tinaField(data, 'description')} class="rounded-2xl border border-border bg-section p-6 md:p-8">
						<span class="eyebrow">{blogCopy?.shortAnswerLabel ?? 'The short answer'}</span>
						<p class="mt-3 max-w-[68ch] text-[15px] leading-relaxed text-body">{data.description}</p>
					</div>
				)}
				{data.heroImage && (
					<img src={mediaUrl(data.heroImage, mediaSite)} alt={data.title ?? ''} width={1200} height={675} data-tina-field={tinaField(data, 'heroImage')} class="mt-10 aspect-[16/9] w-full rounded-2xl object-cover" />
				)}
			</div>
		</section>
		<section class="pb-16 md:pb-24">
			<div class="mx-auto grid max-w-[1200px] items-start gap-12 px-6 md:px-12 lg:grid-cols-[220px_minmax(0,720px)_minmax(0,1fr)] lg:gap-10">
				{toc.length > 0 ? (
					<aside aria-label="Table of contents" class="hidden lg:sticky lg:top-24 lg:block">
						<span class="block text-xs font-semibold uppercase tracking-[0.18em] text-muted-foreground">{blogCopy?.tocLabel ?? 'On this page'}</span>
						<div class="mt-4 flex flex-col gap-3">
							{toc.map((entry) => (
								<a href={`#${entry.id}`} class="text-[13px] leading-snug text-muted-foreground no-underline transition-colors hover:text-primary">{entry.text}</a>
							))}
						</div>
					</aside>
				) : <div aria-hidden="true" class="hidden lg:block" />}
				<article class="min-w-0">
					{hasRichText(data.body) && (
						<div data-tina-field={tinaField(data, 'body')} class="prose prose-lg max-w-none">
							<TinaMarkdown content={data.body} components={articleComponents} />
						</div>
					)}
					{(blogCopy?.ctaTitle || blogCopy?.ctaBody || blogCopy?.ctaLabel) && (
						<div class="mt-12 flex flex-col gap-6 rounded-2xl border border-border bg-section p-7 sm:flex-row sm:items-center sm:justify-between md:p-8">
							<div>
								{blogCopy?.ctaTitle && <h2 class="font-serif text-2xl font-light tracking-[-0.01em] text-ink">{blogCopy.ctaTitle}</h2>}
								{blogCopy?.ctaBody && <p class="mt-2 text-sm leading-relaxed text-muted-foreground">{blogCopy.ctaBody}</p>}
							</div>
							{blogCopy?.ctaLabel && blogCopy?.ctaLink && (
								<GuideActions actions={[{ label: blogCopy.ctaLabel, link: blogCopy.ctaLink, type: 'button' }]} class="shrink-0" />
							)}
						</div>
					)}
					{author && (
						<footer class="mt-10 flex flex-col gap-6 border-t border-border pt-10 sm:flex-row">
							{author.photo && (
								<img src={mediaUrl(author.photo, mediaSite)} alt={author.name ?? ''} width={96} height={96} class="size-24 shrink-0 rounded-full object-cover" />
							)}
							<div>
								<span class="block text-xs font-semibold uppercase tracking-[0.18em] text-muted-foreground">{blogCopy?.aboutAuthorLabel ?? 'About the author'}</span>
								<h2 class="mt-2 font-serif text-2xl font-light tracking-[-0.01em] text-ink">{author.name}</h2>
								{hasRichText(author.bio) && (
									<div class="prose mt-3 max-w-none text-sm [--tw-prose-body:var(--color-muted-foreground)]">
										<TinaMarkdown content={author.bio} components={mdxComponents} />
									</div>
								)}
							</div>
						</footer>
					)}
				</article>
				<div aria-hidden="true" class="hidden lg:block" />
			</div>
		</section>
		{related.length > 0 && (
			<section class="bg-section py-16 md:py-24">
				<div class="mx-auto max-w-[1200px] px-6 md:px-12">
					<p class="eyebrow">{blogCopy?.relatedEyebrow ?? 'Keep reading'}</p>
					<SplitHeading as="h2" text={blogCopy?.relatedHeading ?? 'More from the team.'} accentClass="italic text-primary" class="mt-4 font-serif text-[clamp(1.9rem,3.2vw,2.5rem)] font-light leading-[1.1] tracking-[-0.02em] text-ink" />
					<div class="mt-10 grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
						{related.map((post) => (
							<a href={`/blog/${post._sys.filename}/`} class="group no-underline">
								{post.heroImage && (
									<img src={mediaUrl(post.heroImage, mediaSite)} alt={post.title ?? ''} width={480} height={320} loading="lazy" class="aspect-[3/2] w-full rounded-xl object-cover" />
								)}
								<span class="mt-5 block text-xs font-semibold uppercase tracking-[0.18em] text-muted-foreground">{post.category ?? 'Guides'}</span>
								<h3 class="mt-2 font-serif text-xl font-light leading-snug tracking-[-0.01em] text-ink transition-colors group-hover:text-primary">{post.title}</h3>
							</a>
						))}
					</div>
				</div>
			</section>
		)}
	</>
)}
