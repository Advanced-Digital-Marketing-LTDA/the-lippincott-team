---
import { mediaUrl } from '../lib/media';
const mediaSite = Astro.site?.href ?? Astro.url.origin;
// Import the global.css file here so that it is included on
// all pages through the use of the <BaseHead /> component.
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
// Preload the three variable faces global.css @imports (Inter + Fraunces
// roman/italic) — same hashed URLs the bundled @font-face rules reference,
// so the fonts start with the HTML instead of waiting on the CSS parse.
import interWoff2 from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import frauncesWoff2 from '@fontsource-variable/fraunces/files/fraunces-latin-wght-normal.woff2?url';
import frauncesItalicWoff2 from '@fontsource-variable/fraunces/files/fraunces-latin-wght-italic.woff2?url';

interface Props {
	title: string;
	description: string;
	image?: string;
	/** Keep the page out of search results (functional pages such as the form confirmation). */
	noindex?: boolean;
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const { title, description, image: rawImage, noindex = false } = Astro.props;
const image = mediaUrl(rawImage?.trim() || '/logo.webp', mediaSite);
---

<!-- Global Metadata -->
<meta charset="utf-8" />

<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" type="image/png" sizes="32x32" href="/favicon.png" />
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
<meta name="generator" content={Astro.generator} />

<!-- Font preloads (see frontmatter imports). -->
<link rel="preload" as="font" type="font/woff2" href={interWoff2} crossorigin />
<link rel="preload" as="font" type="font/woff2" href={frauncesWoff2} crossorigin />
<link rel="preload" as="font" type="font/woff2" href={frauncesItalicWoff2} crossorigin />

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />
{noindex && <meta name="robots" content="noindex" />}

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content="website" />
<meta property="og:url" content={Astro.url} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={new URL(image, Astro.url)} />

<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={Astro.url} />
<meta property="twitter:title" content={title} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={new URL(image, Astro.url)} />

<!-- TinaCMS visual editing is wired by the tina() integration in astro.config.mjs; its middleware only touches edit-mode responses, so there's nothing to add here. -->

<ClientRouter />
