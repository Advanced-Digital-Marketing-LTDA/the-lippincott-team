---
type Props = {
	variant?: 'full' | 'compact';
	fullPageHref?: string;
};

import { randomUUID } from 'node:crypto';

const { variant = 'full', fullPageHref = '/seller-net-proceeds-calculator/' } = Astro.props;
const idPrefix = `seller-net-proceeds-${variant}-${randomUUID()}`;
const detailedMoneyFields = [
	{ key: 'detailedClosingCosts.titleEscrow', label: 'Seller-paid title and escrow' },
	{ key: 'detailedClosingCosts.propertyTaxHoaSettlement', label: 'Property-tax and HOA settlement' },
	{ key: 'detailedClosingCosts.concessions', label: 'Concessions' },
	{ key: 'detailedClosingCosts.repairsWarrantySurvey', label: 'Repairs, warranty, and survey' },
	{ key: 'detailedClosingCosts.other', label: 'Other closing expenses' },
] as const;
---

<div class={`home-v2 snp-root ${variant === 'compact' ? 'snp-compact' : 'snp-full'}`} data-snp-calculator data-snp-variant={variant} data-instance={idPrefix}>
	{variant === 'full' ? (
		<section class="snp-intro" aria-labelledby={`${idPrefix}-title`}>
			<div class="snp-wrap">
				<p class="snp-eyebrow">A clearer view of your sale</p>
				<h1 id={`${idPrefix}-title`}>Seller net proceeds <em>calculator</em></h1>
				<p class="snp-intro-copy">Estimate what may remain after mortgage payoffs, closing costs, and the expenses around your move. Enter only the figures you know; blank amounts stay out of the estimate.</p>
				<p class="snp-intro-note">A planning estimate—not a final settlement statement or an appraisal.</p>
			</div>
		</section>
	) : (
		<header class="snp-compact-header">
			<p class="snp-compact-brand">The Lippincott Team</p>
			<h2>Seller net proceeds</h2>
			<p>Build an estimate from the amounts you know.</p>
		</header>
	)}

	{variant === 'full' && (
		<section class="snp-section-intro">
			<div class="snp-wrap">
				<p class="snp-eyebrow">Use your own estimates</p>
				<h2>Add the numbers <em>you know.</em></h2>
				<p>There are no preset commission rates or closing-cost assumptions. Enter a total or estimate the cost categories one by one.</p>
			</div>
		</section>
	)}

	<section class="snp-calculator-section" aria-label="Seller net proceeds calculator">
		<div class="snp-wrap">
			<div class="snp-calculator-shell">
				<div class="snp-calculator-layout">
					<section class="snp-input-panel" aria-labelledby={`${idPrefix}-inputs-title`}>
						<div class="snp-panel-heading">
							<p class="snp-eyebrow">Your estimate</p>
							<h2 id={`${idPrefix}-inputs-title`}>Sale and loan payoffs</h2>
							<p>Amounts are in U.S. dollars, up to $1,000,000,000,000.00. Blank fields are excluded; enter $0 when you know a cost does not apply.</p>
						</div>

						<div class="snp-fields">
							<div class="snp-field" data-field-wrap="salePrice">
								<label for={`${idPrefix}-sale-price`}>Expected sale price <span class="snp-required">Required</span></label>
								<span class="snp-field-note" id={`${idPrefix}-sale-price-hint`}>Enter a positive amount, up to $1,000,000,000,000.00.</span>
								<input id={`${idPrefix}-sale-price`} data-field="salePrice" data-base-describedby={`${idPrefix}-sale-price-hint`} aria-describedby={`${idPrefix}-sale-price-hint`} type="text" inputmode="decimal" autocomplete="off" spellcheck="false" required />
								<span class="snp-error" data-error-for="salePrice" id={`${idPrefix}-sale-price-error`}></span>
							</div>

							<fieldset class="snp-fieldset snp-payoffs">
								<legend>Mortgage and loan payoffs</legend>
								<p class="snp-field-note">Use current estimated balances, including any mortgage or HELOC secured by the property.</p>
								<div class="snp-field" data-field-wrap="payoffs.firstMortgage">
									<label for={`${idPrefix}-first-payoff`}>First mortgage payoff</label>
									<input id={`${idPrefix}-first-payoff`} data-field="payoffs.firstMortgage" data-base-describedby={`${idPrefix}-payoff-hint`} aria-describedby={`${idPrefix}-payoff-hint`} type="text" inputmode="decimal" autocomplete="off" spellcheck="false" />
									<span class="snp-error" data-error-for="payoffs.firstMortgage" id={`${idPrefix}-first-payoff-error`}></span>
								</div>
								<span class="snp-visually-hidden" id={`${idPrefix}-payoff-hint`}>Enter a nonnegative dollar amount, up to $1,000,000,000,000.00.</span>
								<div class="snp-additional-payoffs" data-payoff-list></div>
								<button class="snp-secondary-button" type="button" data-add-payoff>Add another mortgage or HELOC</button>
							</fieldset>

							<fieldset class="snp-fieldset snp-cost-mode">
								<legend>Closing-cost estimate</legend>
								<p class="snp-field-note">Choose one method. Switching methods saves your entries, but only the selected method is included.</p>
								<div class="snp-radio-row" role="group" aria-label="Closing-cost method">
									<label class="snp-radio" for={`${idPrefix}-mode-aggregate`}>
										<input id={`${idPrefix}-mode-aggregate`} type="radio" name={`${idPrefix}-closing-cost-mode`} value="aggregate" data-cost-mode checked />
										<span>One total</span>
									</label>
									<label class="snp-radio" for={`${idPrefix}-mode-detailed`}>
										<input id={`${idPrefix}-mode-detailed`} type="radio" name={`${idPrefix}-closing-cost-mode`} value="detailed" data-cost-mode />
										<span>Itemize costs</span>
									</label>
								</div>

								<fieldset class="snp-mode-panel" data-mode-panel="aggregate">
									<legend class="snp-visually-hidden">One-total closing costs</legend>
									<div class="snp-field" data-field-wrap="aggregateClosingCosts">
										<label for={`${idPrefix}-aggregate-costs`}>Estimated total closing costs</label>
										<span class="snp-field-note">Enter your own estimate; no rate or fee is assumed.</span>
										<input id={`${idPrefix}-aggregate-costs`} data-field="aggregateClosingCosts" data-base-describedby={`${idPrefix}-aggregate-hint`} aria-describedby={`${idPrefix}-aggregate-hint`} type="text" inputmode="decimal" autocomplete="off" spellcheck="false" />
										<span class="snp-visually-hidden" id={`${idPrefix}-aggregate-hint`}>Enter a nonnegative dollar amount, up to $1,000,000,000,000.00.</span>
										<span class="snp-error" data-error-for="aggregateClosingCosts" id={`${idPrefix}-aggregate-costs-error`}></span>
									</div>
								</fieldset>

								<fieldset class="snp-mode-panel" data-mode-panel="detailed" hidden>
									<legend class="snp-visually-hidden">Itemized closing costs</legend>
									<div class="snp-field snp-compensation" data-compensation="listingCompensation">
										<span class="snp-label">Listing-side compensation</span>
										<div class="snp-mini-radios" role="group" aria-label="Listing-side compensation format">
											<label for={`${idPrefix}-listing-dollars`}><input id={`${idPrefix}-listing-dollars`} type="radio" name={`${idPrefix}-listing-mode`} value="dollars" data-comp-mode checked /><span>Dollars</span></label>
											<label for={`${idPrefix}-listing-percent`}><input id={`${idPrefix}-listing-percent`} type="radio" name={`${idPrefix}-listing-mode`} value="percent" data-comp-mode /><span>Percent of sale price</span></label>
										</div>
										<div class="snp-field" data-comp-value-wrap="dollars">
											<label class="snp-visually-hidden" for={`${idPrefix}-listing-dollar-value`}>Listing-side compensation in dollars</label>
											<input id={`${idPrefix}-listing-dollar-value`} data-field="detailedClosingCosts.listingCompensation.value" data-comp-value="dollars" data-base-describedby={`${idPrefix}-listing-dollar-hint`} aria-describedby={`${idPrefix}-listing-dollar-hint`} type="text" inputmode="decimal" autocomplete="off" spellcheck="false" />
											<span class="snp-visually-hidden" id={`${idPrefix}-listing-dollar-hint`}>Enter a nonnegative dollar amount, up to $1,000,000,000,000.00.</span>
										</div>
										<div class="snp-field" data-comp-value-wrap="percent" hidden>
											<label class="snp-visually-hidden" for={`${idPrefix}-listing-percent-value`}>Listing-side compensation as percent of sale price</label>
											<input id={`${idPrefix}-listing-percent-value`} data-field="detailedClosingCosts.listingCompensation.value" data-comp-value="percent" data-base-describedby={`${idPrefix}-listing-percent-hint`} aria-describedby={`${idPrefix}-listing-percent-hint`} type="text" inputmode="decimal" autocomplete="off" spellcheck="false" />
											<span class="snp-visually-hidden" id={`${idPrefix}-listing-percent-hint`}>Enter a percentage from 0 to 100. This is multiplied by the sale price.</span>
										</div>
										<span class="snp-error" data-error-for="detailedClosingCosts.listingCompensation.value" id={`${idPrefix}-listing-error`}></span>
									</div>

									<div class="snp-field snp-compensation" data-compensation="buyerAgentCompensation">
										<span class="snp-label">Buyer-agent compensation paid by seller</span>
										<div class="snp-mini-radios" role="group" aria-label="Buyer-agent compensation format">
											<label for={`${idPrefix}-buyer-dollars`}><input id={`${idPrefix}-buyer-dollars`} type="radio" name={`${idPrefix}-buyer-mode`} value="dollars" data-comp-mode checked /><span>Dollars</span></label>
											<label for={`${idPrefix}-buyer-percent`}><input id={`${idPrefix}-buyer-percent`} type="radio" name={`${idPrefix}-buyer-mode`} value="percent" data-comp-mode /><span>Percent of sale price</span></label>
										</div>
										<div class="snp-field" data-comp-value-wrap="dollars">
											<label class="snp-visually-hidden" for={`${idPrefix}-buyer-dollar-value`}>Buyer-agent compensation in dollars</label>
											<input id={`${idPrefix}-buyer-dollar-value`} data-field="detailedClosingCosts.buyerAgentCompensation.value" data-comp-value="dollars" data-base-describedby={`${idPrefix}-buyer-dollar-hint`} aria-describedby={`${idPrefix}-buyer-dollar-hint`} type="text" inputmode="decimal" autocomplete="off" spellcheck="false" />
											<span class="snp-visually-hidden" id={`${idPrefix}-buyer-dollar-hint`}>Enter a nonnegative dollar amount, up to $1,000,000,000,000.00.</span>
										</div>
										<div class="snp-field" data-comp-value-wrap="percent" hidden>
											<label class="snp-visually-hidden" for={`${idPrefix}-buyer-percent-value`}>Buyer-agent compensation as percent of sale price</label>
											<input id={`${idPrefix}-buyer-percent-value`} data-field="detailedClosingCosts.buyerAgentCompensation.value" data-comp-value="percent" data-base-describedby={`${idPrefix}-buyer-percent-hint`} aria-describedby={`${idPrefix}-buyer-percent-hint`} type="text" inputmode="decimal" autocomplete="off" spellcheck="false" />
											<span class="snp-visually-hidden" id={`${idPrefix}-buyer-percent-hint`}>Enter a percentage from 0 to 100. This is multiplied by the sale price.</span>
										</div>
										<span class="snp-error" data-error-for="detailedClosingCosts.buyerAgentCompensation.value" id={`${idPrefix}-buyer-error`}></span>
									</div>

									{detailedMoneyFields.map((field) => (
										<div class="snp-field" data-field-wrap={field.key}>
											<label for={`${idPrefix}-${field.key.split('.').at(-1)}`}>{field.label}</label>
											<input id={`${idPrefix}-${field.key.split('.').at(-1)}`} data-field={field.key} data-base-describedby={`${idPrefix}-${field.key.split('.').at(-1)}-hint`} aria-describedby={`${idPrefix}-${field.key.split('.').at(-1)}-hint`} type="text" inputmode="decimal" autocomplete="off" spellcheck="false" />
											<span class="snp-visually-hidden" id={`${idPrefix}-${field.key.split('.').at(-1)}-hint`}>Enter a nonnegative dollar amount, up to $1,000,000,000,000.00.</span>
											<span class="snp-error" data-error-for={field.key} id={`${idPrefix}-${field.key.split('.').at(-1)}-error`}></span>
										</div>
									))}
								</fieldset>
							</fieldset>

							<fieldset class="snp-fieldset snp-other-expenses">
								<legend>Other expenses around your move</legend>
								<p class="snp-field-note">These are shown separately from cash at closing.</p>
								<div class="snp-field" data-field-wrap="otherExpenses.preparation">
									<label for={`${idPrefix}-preparation`}>Preparation costs</label>
									<input id={`${idPrefix}-preparation`} data-field="otherExpenses.preparation" data-base-describedby={`${idPrefix}-other-hint`} aria-describedby={`${idPrefix}-other-hint`} type="text" inputmode="decimal" autocomplete="off" spellcheck="false" />
									<span class="snp-error" data-error-for="otherExpenses.preparation" id={`${idPrefix}-preparation-error`}></span>
								</div>
								<div class="snp-field" data-field-wrap="otherExpenses.moving">
									<label for={`${idPrefix}-moving`}>Moving costs</label>
									<input id={`${idPrefix}-moving`} data-field="otherExpenses.moving" data-base-describedby={`${idPrefix}-other-hint`} aria-describedby={`${idPrefix}-other-hint`} type="text" inputmode="decimal" autocomplete="off" spellcheck="false" />
									<span class="snp-error" data-error-for="otherExpenses.moving" id={`${idPrefix}-moving-error`}></span>
								</div>
								<div class="snp-field" data-field-wrap="otherExpenses.carrying">
									<label for={`${idPrefix}-carrying`}>Carrying costs</label>
									<input id={`${idPrefix}-carrying`} data-field="otherExpenses.carrying" data-base-describedby={`${idPrefix}-other-hint`} aria-describedby={`${idPrefix}-other-hint`} type="text" inputmode="decimal" autocomplete="off" spellcheck="false" />
									<span class="snp-error" data-error-for="otherExpenses.carrying" id={`${idPrefix}-carrying-error`}></span>
								</div>
								<span class="snp-visually-hidden" id={`${idPrefix}-other-hint`}>Enter a nonnegative dollar amount, up to $1,000,000,000,000.00.</span>
							</fieldset>
						</div>

						<p class="snp-privacy-note">This calculator uses your entries to make an on-page estimate and does not submit them through calculator code. Existing site analytics behavior has not been verified.</p>
					</section>

					<aside class="snp-result-panel" aria-labelledby={`${idPrefix}-results-title`}>
						<div class="snp-result-heading">
							<p class="snp-eyebrow">Your estimate</p>
							<h2 id={`${idPrefix}-results-title`}>Estimated proceeds</h2>
						</div>
						<div class="snp-result-prompt" data-result-prompt>
							<h3>Start with an expected sale price</h3>
							<p>Your estimate will appear here as you enter the amounts you know.</p>
						</div>
						<div class="snp-result-invalid" data-result-invalid hidden>
							<h3>Review the highlighted amounts</h3>
							<p>Correct each highlighted field to update the estimate. No previous result is shown while an amount is invalid.</p>
						</div>
						<div class="snp-result-content" data-result-content hidden>
							<div class="snp-result-ledger" data-result-ledger></div>
							<div class="snp-omissions" data-omissions hidden>
								<h3>Some costs are not included</h3>
								<p data-omissions-copy></p>
							</div>
							<div class="snp-inactive-mode" data-inactive-mode hidden></div>
							<p class="snp-negative-warning" data-negative-warning hidden></p>
							<p class="snp-estimate-note">This is an estimate based on the amounts entered, not a final settlement statement. Actual amounts can vary.</p>
						</div>
						<p class="snp-live snp-visually-hidden" data-live role="status" aria-live="polite" aria-atomic="true"></p>
					</aside>
				</div>
			</div>

			{variant === 'compact' && (
				<p class="snp-full-page-link"><a href={fullPageHref}>Open the full calculator page <span aria-hidden="true">↗</span></a></p>
			)}
		</div>
	</section>

	{variant === 'full' && (
		<section class="snp-contact-band">
			<div class="snp-wrap snp-contact-inner">
				<div>
					<p class="snp-eyebrow">A thoughtful next step</p>
					<h2>Talk through your <em>selling plans.</em></h2>
					<p>For a closer look at the costs in your situation, connect with our team.</p>
				</div>
				<a class="snp-contact-button" href="/contact-us/">Contact the team <span aria-hidden="true">→</span></a>
			</div>
		</section>
	)}

	<template data-payoff-template>
		<div class="snp-field snp-added-payoff" data-payoff-row>
			<label data-payoff-label></label>
			<div class="snp-payoff-row-control">
				<input data-additional-payoff data-base-describedby={`${idPrefix}-payoff-hint`} aria-describedby={`${idPrefix}-payoff-hint`} type="text" inputmode="decimal" autocomplete="off" spellcheck="false" />
				<button class="snp-remove-payoff" type="button" data-remove-payoff>Remove</button>
			</div>
			<span class="snp-error" data-payoff-error></span>
		</div>
	</template>
</div>

<script>
	import { calculateSellerNetProceeds, formatCurrencyCents, parseCurrencyCents, type ClosingCostMode, type SellerNetProceedsInput, type SellerNetProceedsResult } from '../../lib/seller-net-proceeds';

	function initializeCalculators() {
		document.querySelectorAll<HTMLElement>('[data-snp-calculator]').forEach((root) => {
			if (root.dataset.bound === 'true') return;
			root.dataset.bound = 'true';

			const one = <T extends Element>(selector: string) => root.querySelector<T>(selector);
			const many = <T extends Element>(selector: string) => Array.from(root.querySelectorAll<T>(selector));
			const addPayoffButton = one<HTMLButtonElement>('[data-add-payoff]');
			const payoffList = one<HTMLElement>('[data-payoff-list]');
			const payoffTemplate = one<HTMLTemplateElement>('[data-payoff-template]');
			const resultPrompt = one<HTMLElement>('[data-result-prompt]');
			const resultInvalid = one<HTMLElement>('[data-result-invalid]');
			const resultPanel = one<HTMLElement>('.snp-result-panel');
			const resultContent = one<HTMLElement>('[data-result-content]');
			const ledger = one<HTMLElement>('[data-result-ledger]');
			const omissions = one<HTMLElement>('[data-omissions]');
			const omissionsCopy = one<HTMLElement>('[data-omissions-copy]');
			const inactiveMode = one<HTMLElement>('[data-inactive-mode]');
			const negativeWarning = one<HTMLElement>('[data-negative-warning]');
			const liveRegion = one<HTMLElement>('[data-live]');
			let liveTimer: ReturnType<typeof setTimeout> | undefined;

			const field = (key: string) => many<HTMLInputElement>('[data-field]').find((element) => element.dataset.field === key);
			const getValue = (key: string) => field(key)?.value ?? '';
			const setLive = (message: string) => {
				if (!liveRegion) return;
				if (liveTimer) clearTimeout(liveTimer);
				liveTimer = setTimeout(() => { liveRegion.textContent = message; liveTimer = undefined; }, 450);
			};
			const cancelPendingLive = () => {
				if (liveTimer) clearTimeout(liveTimer);
				liveTimer = undefined;
				if (liveRegion) liveRegion.textContent = '';
			};

			const resetErrors = () => {
				many<HTMLInputElement>('[data-field], [data-additional-payoff], [data-comp-value]').forEach((input) => {
					input.removeAttribute('aria-invalid');
					const base = input.dataset.baseDescribedby;
					if (base) input.setAttribute('aria-describedby', base);
				});
				many<HTMLElement>('[data-error-for], [data-payoff-error]').forEach((error) => { error.textContent = ''; });
			};

			const setFieldError = (key: string, message: string) => {
				const input = many<HTMLInputElement>('[data-field], [data-additional-payoff]').find((element) => element.dataset.field === key && !element.closest('[hidden]'));
			if (!input) return;
			input.setAttribute('aria-invalid', 'true');
			const error = many<HTMLElement>('[data-error-for], [data-payoff-error]').find((element) => element.dataset.errorFor === key || element.dataset.errorField === key);
			if (error) {
				error.textContent = message;
				const describedBy = input.getAttribute('aria-describedby')?.split(/\s+/).filter(Boolean) ?? [];
				if (error.id && !describedBy.includes(error.id)) describedBy.push(error.id);
				if (describedBy.length) input.setAttribute('aria-describedby', describedBy.join(' '));
			}
		};

			const updatePayoffRows = () => {
				const rows = many<HTMLElement>('[data-payoff-row]');
				rows.forEach((row, index) => {
					const position = index + 1;
					const key = `payoffs.additional.${index}`;
					const label = row.querySelector<HTMLLabelElement>('[data-payoff-label]');
					const input = row.querySelector<HTMLInputElement>('[data-additional-payoff]');
					const error = row.querySelector<HTMLElement>('[data-payoff-error]');
					const remove = row.querySelector<HTMLButtonElement>('[data-remove-payoff]');
					if (label) {
						label.textContent = `Additional mortgage or HELOC payoff ${position}`;
						label.htmlFor = `${root.dataset.instance}-additional-payoff-${position}`;
					}
					if (input) {
						input.id = `${root.dataset.instance}-additional-payoff-${position}`;
						input.dataset.field = key;
						input.dataset.baseDescribedby = `${root.dataset.instance}-payoff-hint`;
					}
					if (error) {
						error.id = `${root.dataset.instance}-additional-payoff-${position}-error`;
						error.dataset.errorField = key;
					}
					if (remove) remove.setAttribute('aria-label', `Remove additional loan payoff ${position}`);
				});
				if (addPayoffButton) addPayoffButton.disabled = rows.length >= 8;
			};

			const currentMode = (): ClosingCostMode => {
				const selected = one<HTMLInputElement>('[data-cost-mode]:checked')?.value;
				return selected === 'detailed' ? 'detailed' : 'aggregate';
			};

			const refreshModePanels = () => {
				const mode = currentMode();
				many<HTMLElement>('[data-mode-panel]').forEach((panel) => { panel.hidden = panel.dataset.modePanel !== mode; });
				many<HTMLElement>('[data-compensation]').forEach((group) => {
					const selected = group.querySelector<HTMLInputElement>('[data-comp-mode]:checked')?.value === 'percent' ? 'percent' : 'dollars';
					group.querySelectorAll<HTMLElement>('[data-comp-value-wrap]').forEach((wrap) => { wrap.hidden = wrap.dataset.compValueWrap !== selected; });
				});
			};

			const readInput = (): SellerNetProceedsInput => {
				const compensation = (name: string) => {
					const group = one<HTMLElement>(`[data-compensation="${name}"]`);
					const mode = group?.querySelector<HTMLInputElement>('[data-comp-mode]:checked')?.value === 'percent' ? 'percent' : 'dollars';
					const value = group?.querySelector<HTMLInputElement>(`[data-comp-value="${mode}"]`)?.value ?? '';
					return { mode, value } as const;
				};
				return {
					salePrice: getValue('salePrice'),
					payoffs: {
						firstMortgage: getValue('payoffs.firstMortgage'),
						additional: many<HTMLInputElement>('[data-additional-payoff]').map((input) => input.value),
					},
					closingCostMode: currentMode(),
					aggregateClosingCosts: getValue('aggregateClosingCosts'),
					detailedClosingCosts: {
						listingCompensation: compensation('listingCompensation'),
						buyerAgentCompensation: compensation('buyerAgentCompensation'),
						titleEscrow: getValue('detailedClosingCosts.titleEscrow'),
						propertyTaxHoaSettlement: getValue('detailedClosingCosts.propertyTaxHoaSettlement'),
						concessions: getValue('detailedClosingCosts.concessions'),
						repairsWarrantySurvey: getValue('detailedClosingCosts.repairsWarrantySurvey'),
						other: getValue('detailedClosingCosts.other'),
					},
					otherExpenses: {
						preparation: getValue('otherExpenses.preparation'),
						moving: getValue('otherExpenses.moving'),
						carrying: getValue('otherExpenses.carrying'),
					},
				};
			};

			const appendLedgerRow = (label: string, cents: bigint, kind: 'normal' | 'deduction' | 'total' | 'result') => {
				if (!ledger) return;
				const row = document.createElement('div');
				row.className = `snp-ledger-row snp-ledger-${kind}`;
				const name = document.createElement('span');
				name.className = 'snp-ledger-label';
				name.textContent = label;
				const value = document.createElement('span');
				value.className = 'snp-ledger-value';
				value.textContent = formatCurrencyCents(cents);
				row.append(name, value);
				ledger.append(row);
			};

			const appendLedgerSection = (label: string) => {
				if (!ledger) return;
				const heading = document.createElement('h3');
				heading.className = 'snp-ledger-section-title';
				heading.textContent = label;
				ledger.append(heading);
			};

			const renderResult = (result: SellerNetProceedsResult) => {
				if (!ledger) return;
				const displayedAmounts = [
					result.salePriceCents,
					...result.payoffLines.map((line) => -line.cents),
					-result.totalPayoffsCents,
					...result.closingCostLines.map((line) => -line.cents),
					-result.totalClosingCostsCents,
					result.cashAtClosingCents,
					...result.otherExpenseLines.map((line) => -line.cents),
					-result.totalOtherExpensesCents,
					result.amountAfterOtherExpensesCents,
				];
				resultPanel?.classList.toggle('snp-stacked-ledger', displayedAmounts.some((cents) => formatCurrencyCents(cents).length > 13));
				ledger.replaceChildren();
				appendLedgerRow('Expected sale price', result.salePriceCents, 'normal');

				appendLedgerSection('Loan payoffs');
				result.payoffLines.forEach((line) => appendLedgerRow(line.label, -line.cents, 'deduction'));
				appendLedgerRow('Total loan payoffs', -result.totalPayoffsCents, 'total');

				appendLedgerSection('Closing costs');
			result.closingCostLines.forEach((line) => appendLedgerRow(line.label, -line.cents, 'deduction'));
				appendLedgerRow('Total closing costs', -result.totalClosingCostsCents, 'total');
				appendLedgerRow('Estimated cash at closing', result.cashAtClosingCents, 'result');

				appendLedgerSection('Other expenses around your move');
				result.otherExpenseLines.forEach((line) => appendLedgerRow(line.label, -line.cents, 'deduction'));
				appendLedgerRow('Total other expenses', -result.totalOtherExpensesCents, 'total');
				appendLedgerRow('Estimated after other expenses', result.amountAfterOtherExpensesCents, 'result');

				if (omissions && omissionsCopy) {
					omissions.hidden = result.omittedFields.length === 0;
					omissionsCopy.textContent = result.omittedFields.length
						? `Blank amounts were left out: ${result.omittedFields.join(', ')}. Enter $0 when you know a listed amount does not apply.`
						: '';
				}
				if (inactiveMode) {
					inactiveMode.hidden = result.inactiveClosingCostMode === null;
					inactiveMode.textContent = result.inactiveClosingCostMode === 'aggregate'
						? 'Your saved one-total closing-cost amount is not counted while itemized costs are selected.'
						: result.inactiveClosingCostMode === 'detailed'
							? 'Your saved itemized closing-cost amounts are not counted while one-total costs are selected.'
							: '';
				}
				if (negativeWarning) {
					const cashShortfall = result.cashAtClosingCents < 0n;
					const afterExpensesShortfall = result.amountAfterOtherExpensesCents < 0n;
					negativeWarning.hidden = !cashShortfall && !afterExpensesShortfall;
					negativeWarning.textContent = cashShortfall
						? 'Estimated cash at closing is below $0. Additional funds may be needed to complete the sale.'
						: afterExpensesShortfall
							? 'After the other expenses entered, the estimate is below $0. Those amounts are separate from cash at closing.'
							: '';
				}
				if (resultPrompt) resultPrompt.hidden = true;
				if (resultInvalid) resultInvalid.hidden = true;
				if (resultContent) resultContent.hidden = false;
				setLive(`Estimate updated. Estimated cash at closing ${formatCurrencyCents(result.cashAtClosingCents)}. Estimated after other expenses ${formatCurrencyCents(result.amountAfterOtherExpensesCents)}.`);
			};

			const update = (announce = true) => {
				resetErrors();
				const input = readInput();
				const salePrice = parseCurrencyCents(input.salePrice);
				const outcome = calculateSellerNetProceeds(input);
				if (salePrice.kind === 'blank') {
					cancelPendingLive();
					if (!outcome.ok) {
						Object.entries(outcome.errors).filter(([key]) => key !== 'salePrice').forEach(([key, message]) => setFieldError(key, message));
					}
					if (resultPrompt) resultPrompt.hidden = false;
					if (resultInvalid) resultInvalid.hidden = true;
					if (resultContent) resultContent.hidden = true;
					if (announce && !outcome.ok && Object.keys(outcome.errors).some((key) => key !== 'salePrice')) {
						setLive('Correct the highlighted amounts, then enter an expected sale price to start an estimate.');
					}
					return;
				}

				if (!outcome.ok) {
					cancelPendingLive();
					Object.entries(outcome.errors).forEach(([key, message]) => setFieldError(key, message));
					if (resultPrompt) resultPrompt.hidden = true;
					if (resultInvalid) resultInvalid.hidden = false;
					if (resultContent) resultContent.hidden = true;
					if (announce) setLive(`${Object.keys(outcome.errors).length} amount${Object.keys(outcome.errors).length === 1 ? '' : 's'} need correction. Previous results are hidden.`);
					return;
				}
				renderResult(outcome.result);
			};

			const onInput = (event: Event) => {
				if ((event.target as HTMLElement).matches('[data-field], [data-additional-payoff], [data-comp-value]')) update();
			};
			const onChange = (event: Event) => {
				if ((event.target as HTMLElement).matches('[data-cost-mode], [data-comp-mode]')) {
					refreshModePanels();
					update();
				}
			};
			const onClick = (event: Event) => {
				const target = event.target;
				if (!(target instanceof Element)) return;
				if (target.closest('[data-add-payoff]')) {
					if (!payoffList || !payoffTemplate || many<HTMLElement>('[data-payoff-row]').length >= 8) return;
					payoffList.append(payoffTemplate.content.cloneNode(true));
					updatePayoffRows();
					many<HTMLInputElement>('[data-additional-payoff]').at(-1)?.focus();
					update();
					return;
				}
				const removeButton = target.closest<HTMLButtonElement>('[data-remove-payoff]');
				if (removeButton) {
					const rowsBefore = many<HTMLElement>('[data-payoff-row]');
					const removedIndex = rowsBefore.indexOf(removeButton.closest<HTMLElement>('[data-payoff-row]') as HTMLElement);
					removeButton.closest('[data-payoff-row]')?.remove();
					updatePayoffRows();
					const rowsAfter = many<HTMLElement>('[data-payoff-row]');
					const next = rowsAfter[Math.min(removedIndex, rowsAfter.length - 1)];
					(next?.querySelector<HTMLInputElement>('[data-additional-payoff]') ?? addPayoffButton)?.focus();
					update();
				}
			};

			root.addEventListener('input', onInput);
			root.addEventListener('change', onChange);
			root.addEventListener('click', onClick);
			refreshModePanels();
			update(false);
		});
	}

	initializeCalculators();
	document.addEventListener('astro:page-load', initializeCalculators);
</script>

