---
import { mediaUrl } from '../../lib/media';
const mediaSite = Astro.site?.href ?? Astro.url.origin;
import { getConfig, getPage } from '../../lib/data';
import type { DataTableBlock, PageBlock } from '../../lib/data';
import { isExternal, safeHref } from '../../lib/url';
import { richTextToPlainText } from '../../lib/rich-text';

const normalizedAnchor = (value?: string | null) => value?.trim().replace(/^#/, '');
const page = (await getPage('northwest-houston-real-estate')).data.page;
const blocks = (page?.blocks ?? []).filter((block): block is PageBlock => block !== null);
const comparison = blocks.find(
	(block): block is DataTableBlock =>
		block.__typename === 'PageBlocksDataTable' && normalizedAnchor(block.anchorId) === 'communities',
);

const medianHeader = comparison?.headers?.[1]?.heading?.trim().toLowerCase();
const daysHeader = comparison?.headers?.[3]?.heading?.trim().toLowerCase();
const hasExpectedColumns =
	medianHeader === 'active listing median' &&
	daysHeader === 'median listing age';
const sourceSummary = richTextToPlainText(comparison?.summary);
let validationError: string | undefined;
if (!comparison) {
	validationError = 'Regional market comparison requires the Northwest Houston #communities data table.';
} else if (!hasExpectedColumns) {
	validationError = 'Regional market comparison requires its active-listing median and listing-age columns in positions 2 and 4.';
} else if (!sourceSummary) {
	validationError = 'Regional market comparison requires a source summary with the reporting period and property scope.';
}

const markets = (hasExpectedColumns ? comparison?.rows ?? [] : [])
	.filter((row) => row !== null)
	.map((row) => {
		const cells = row.cells ?? [];
		// Index the raw cells array — filtering out null cells first would
		// reindex the columns and shift `days` (column 3) out of place.
		return {
			market: cells[0]?.text?.trim(),
			median: cells[1]?.text?.trim(),
			days: cells[3]?.text?.trim(),
		};
	});

const requiredMarkets = ['Cypress', 'Magnolia', 'Tomball', 'Katy', 'Waller', 'Hockley'];
const hasMarket = (name: string) => markets.some(({ market }) => market?.toLowerCase() === name.toLowerCase());

if (comparison && hasExpectedColumns && (
	markets.length !== requiredMarkets.length ||
	!requiredMarkets.every(hasMarket) ||
	markets.some(({ market, median, days }) => !market || !median || !days)
)) {
	validationError = 'Regional market comparison requires the six cities Cypress, Magnolia, Tomball, Katy, Waller and Hockley with median list price and days on market.';
}

// Keep publication strict, but let the rest of the editor preview render while
// the shared table is incomplete. Restoring valid data restores the comparison.
if (validationError && Astro.isPrerendered) {
	throw new Error(validationError);
}

const labels = (await getConfig()).data?.config?.marketTable;
const linkHref = mediaUrl(safeHref(labels?.link), mediaSite) ?? '/northwest-houston-real-estate/#communities';
---

{!validationError && <section class="regional-market-comparison reveal" aria-labelledby="regional-market-heading">
	<h3 id="regional-market-heading">{labels?.heading ?? 'Northwest Houston at a Glance'}</h3>
	<p>{sourceSummary}</p>
	<table>
		<caption class="sr-only">{labels?.caption ?? 'Northwest Houston market and community comparison'}</caption>
		<thead>
			<tr>
				<th scope="col">{labels?.areaLabel ?? 'Area'}</th>
				<th scope="col">{labels?.medianLabel ?? 'Active listing median'}</th>
				<th scope="col">{labels?.daysLabel ?? 'Median listing age'}</th>
			</tr>
		</thead>
		<tbody>
			{markets.map(({ market, median, days }) => (
				<tr>
					<th scope="row">{market}</th>
					<td>{median}</td>
					<td>{days}</td>
				</tr>
			))}
		</tbody>
	</table>
	<p><a href={linkHref} {...(isExternal(labels?.link) ? { target: '_blank', rel: 'noopener' } : {})}>{labels?.linkLabel ?? 'Sources & full comparison'}</a></p>
</section>}
