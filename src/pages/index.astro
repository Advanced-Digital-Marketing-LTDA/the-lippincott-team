---
import { mediaUrl } from '../lib/media';
const mediaSite = Astro.site?.href ?? Astro.url.origin;
import Base from '../layouts/Base.astro';
import TinaIsland from '@tinacms/astro/TinaIsland.astro';
import StandaloneBody from '../components/standalone/StandaloneBody.astro';
import V2Motion from '../components/v2/V2Motion.astro';
import { getConfig, getStandalone } from '../lib/data';
import { islands } from '../lib/islands';
import { hasRichText, richTextToPlainText } from '../lib/rich-text';
import { telHref } from '../lib/url';
// Shared "Verified Record" (.home-v2) design system — also used by buy/sell.
import '../styles/v2.css';

const result = await getStandalone('home');
const data = result.data?.standalone;
if (!data || data.__typename !== 'StandaloneHome') return new Response('Not Found', { status: 404 });
const config = (await getConfig()).data?.config ?? null;

const phone = config?.contact?.phone ?? null;
const email = data.finalCta?.email?.trim() ? data.finalCta.email : (config?.contact?.email ?? null);
const agent = data.agentSchema;
// "17803 W Cypress Hill Circle\nCypress, TX 77433" -> PostalAddress parts (null when the format differs).
const addressMatch = /^(.+)\n(.+?),\s*([A-Z]{2})\s+(\d{5})$/.exec(config?.contact?.address?.trim() ?? '');
const address = addressMatch
	? { street: addressMatch[1], city: addressMatch[2], region: addressMatch[3], postalCode: addressMatch[4] }
	: null;
const faqItems = (data.faq?.items ?? []).filter((q) => q !== null).filter((q) => q.question?.trim() && hasRichText(q.answer));
const jsonld = [
	agent && {
		'@context': 'https://schema.org',
		'@type': 'RealEstateAgent',
		'@id': `${Astro.site?.href ?? ''}#team`,
		name: config?.seo?.title ?? undefined,
		description: agent.description ?? undefined,
		url: Astro.site?.href,
		...(config?.seo?.logo ? { logo: new URL(mediaUrl(config.seo.logo, mediaSite), mediaSite).href } : {}),
		...(address
			? {
					address: {
						'@type': 'PostalAddress',
						streetAddress: address.street,
						addressLocality: address.city,
						addressRegion: address.region,
						postalCode: address.postalCode,
						addressCountry: 'US',
					},
				}
			: {}),
		employee: { '@type': 'Person', name: 'Amy Lippincott', jobTitle: 'Broker' },
		...(phone ? { telephone: telHref(phone)?.replace(/^tel:/, '') } : {}),
		...(email ? { email } : {}),
		...(config?.seo?.brandSubtitle
			? { parentOrganization: { '@type': 'Organization', name: config.seo.brandSubtitle } }
			: {}),
		areaServed: (agent.areasServed ?? [])
			.filter((a) => a !== null)
			.map((a) => ({ '@type': a.kind ?? 'Place', name: a.name })),
		...(agent.award ? { award: agent.award } : {}),
		...(agent.rating
			? {
					aggregateRating: {
						'@type': 'AggregateRating',
						ratingValue: agent.rating,
						bestRating: '5',
						reviewCount: agent.reviewCount ?? undefined,
					},
				}
			: {}),
	},
	faqItems.length > 0 && {
		'@context': 'https://schema.org',
		'@type': 'FAQPage',
		mainEntity: faqItems.map((q) => ({
			'@type': 'Question',
			name: q.question,
			acceptedAnswer: { '@type': 'Answer', text: richTextToPlainText(q.answer) },
		})),
	},
].filter(Boolean);
---

<Base
	title={data.seoTitle?.trim() || config?.seo?.title?.trim() || 'The Lippincott Team'}
	description={data.description?.trim() || config?.seo?.description || ''}
	image={data.socialImage ?? undefined}
>
	{/* The hero video's poster is the LCP image — discover it from the HTML head
	    instead of waiting for the <video> element to be parsed. */}
	{data.hero?.poster && <link slot="head" rel="preload" as="image" href={mediaUrl(data.hero.poster, mediaSite)} fetchpriority="high" />}
	{jsonld.map((entry) => <script type="application/ld+json" is:inline set:html={JSON.stringify(entry).replace(/</g, '\\u003c')} />)}

	<TinaIsland name="standalone" wrapper={islands.standalone.wrapper} params={{ slug: 'home' }} primary>
		<StandaloneBody data={data} />
	</TinaIsland>

	<V2Motion />
</Base>
