# Site configuration template. Create an untracked .env for local use; never
# overwrite an existing .env or commit real secrets. Only PUBLIC_TINA_CLIENT_ID
# and the CDN settings are public; never prefix secret keys with PUBLIC_.
#
# pnpm dev and the build configs load .env locally. A deployed container does
# not: inject runtime variables through the host. For a local standalone build:
# node --env-file=.env ./dist/server/entry.mjs
#
# Coolify/Docker: supply build variables as Docker build args and runtime
# variables to the running container. A build ARG does not populate runtime
# process.env. Redeploy after build changes; recreate/redeploy the container
# after runtime changes. Netlify runtime values belong in its environment UI
# with Functions scope, not just netlify.toml's build environment.

# REQUIRED FOR PRODUCTION: canonical site URL, available at BUILD + RUNTIME.
# Used for sitemap/RSS/OpenGraph, the contact origin allowlist, and page purges.
# Keep the production URL here; add alternate serving origins separately below.
# For local-only development this can instead be http://localhost:4321.
SITE_URL=https://thelippincottteam.com

# BUILD-TIME media delivery; absent/blank defaults to full-site.
# media-only serves the website directly and owned /uploads/ via Bunny Storage.
# PUBLIC_MEDIA_URL must be an HTTPS origin, not a path. Rebuild to switch.
PUBLIC_CDN_MODE=full-site
# PUBLIC_MEDIA_URL=https://media.thelippincottteam.com

# REQUIRED FOR pnpm build / pnpm build:preview: BUILD-TIME TinaCloud credentials
# from the site's project at https://app.tina.io. Fill in both values.
# On Coolify, enable Build Variable for both. TINA_TOKEN is secret.
# pnpm dev and pnpm build:local can use local content without cloud credentials;
# build:local is for local/offline verification, not a TinaCloud-connected deploy.
PUBLIC_TINA_CLIENT_ID=
TINA_TOKEN=

# OPTIONAL BUILD-TIME Tina branch override outside Docker; unset defaults to
# the host's branch metadata, then main. Local cloud builds do not infer the
# checked-out Git branch. Set dev only when deliberately targeting that branch.
# GITHUB_BRANCH=dev
# Coolify injects COOLIFY_BRANCH; keep its Build Variable enabled so the existing
# Dockerfile forwards it. Do not replace platform branch metadata with a fixed
# main/dev value. GITHUB_BRANCH is not forwarded by the current Dockerfile.

# REQUIRED FOR CONTACT SUBMISSIONS: RUNTIME-ONLY Sierra API key from the correct
# Sierra account's Integrations settings. On Coolify, disable Build Variable.
# Leave unset only when deliberately disabling lead forwarding; forms then fail.
SIERRA_API_KEY=

# OPTIONAL RUNTIME override; this is Sierra's documented lead endpoint despite
# "dev" in the hostname. Unset uses the same default; do not set an empty value.
# Must be the full POST /leads URL, not the website or documentation root.
SIERRA_API_URL=https://api.sierrainteractivedev.com/leads

# OPTIONAL RUNTIME extra contact-form origins, comma-separated scheme://host[:port].
# These ADD to SITE_URL, supported platform URLs, and the built-in origins:
# https://thelippincottteam.com, https://www.thelippincottteam.com,
# https://lippincottteam.com, https://www.lippincottteam.com,
# http://localhost:4321 and http://localhost:4322.
# Use exact origins: no paths, wildcards, or surrounding quotes in hosting UIs.
# The current direct Coolify test origin needs this value if it is not supplied
# by a runtime platform URL. HTTP is for dummy test data only; configure valid
# HTTPS before collecting real contact details, then update the allowed origin.
# Example value to put in CONTACT_ALLOWED_ORIGINS below for direct Coolify testing:
# http://lrmrpayrrcyadik6utzhit1l.169.58.185.96.sslip.io
# Multiple-origin example value for local standalone testing:
# http://localhost:3000,http://127.0.0.1:3000
CONTACT_ALLOWED_ORIGINS=

# OPTIONAL BUILD-TIME adapter override. Otherwise auto-detected from Vercel,
# Cloudflare and Netlify platform flags, with Node standalone as the fallback.
# Valid values: node, netlify, vercel, cloudflare. Leave unset, not empty, for auto.
# DEPLOY_ADAPTER=node
# The supplied Dockerfile targets Node; it does not forward DEPLOY_ADAPTER.

# OPTIONAL DOCKER BUILD ARG: choose the package script (default build).
# Allowed: build, build:preview, build:local. build:preview still needs TinaCloud
# credentials; it skips the cloud schema check for an unindexed staging branch.
# Merely adding this to a local .env does not select a pnpm command.
# BUILD_SCRIPT=build

# OPTIONAL NODE STANDALONE RUNTIME settings. Docker already sets these defaults.
# Keep PORT consistent with Coolify's Ports Exposes / container routing; if the
# existing deployment uses 3000, keep its routing and PORT aligned instead.
# HOST=0.0.0.0
# PORT=4321
# NODE_ENV=production is set by the build scripts and Dockerfile. Do not force it
# in a local development .env. Docker/Netlify builds already set a 4 GiB heap;
# for other build environments the equivalent optional setting is:
# NODE_OPTIONS=--max-old-space-size=4096

# OPTIONAL BUNNY DEPLOY PURGES: configure these as GitHub Actions repository
# secrets, NOT app build variables. The workflow waits for the deployed commit
# before purging. Filling this local template does not configure GitHub secrets.
# Prefer a least-privilege pull-zone-scoped API key; never commit real values.
# Full-zone purges require both the key and the numeric pull-zone ID.
# BUNNY_API_KEY=
# BUNNY_PULL_ZONE_ID=
# Linked Storage MEDIA Pull Zone, distinct from the website zone.
# Required in media-only; used before the main zone in full-site.
# BUNNY_MEDIA_API_KEY=
# BUNNY_MEDIA_PULL_ZONE_ID=
# Direct origin without the CDN, recommended as a repository secret. The GitHub
# workflow falls back to its SITE_URL secret, then https://thelippincottteam.com.
# BUNNY_ORIGIN_URL=
# Set BUNNY_PURGE_REQUIRED=true as a GitHub Actions repository VARIABLE if missing
# purge secrets must fail CI. Requires media credentials in media-only, BOTH
# zone pairs in full-site. An app runtime variable does not configure this.
# BUNNY_PURGE_REQUIRED=true

# OPTIONAL FULL-SITE RUNTIME page purge endpoint (/api/bunny-purge): requires SITE_URL,
# BUNNY_API_KEY and BUNNY_PURGE_SECRET in the app's runtime environment. It does
# not need BUNNY_PULL_ZONE_ID. Only expose the Bunny key to runtime if using this
# endpoint or the no-CI fallback below; keep Build Variable off for these secrets.
# Generate the webhook secret with openssl rand -hex 32; send it as a Bearer token
# or x-bunny-purge-token header. Do not put secrets in publicly shared URLs.
# BUNNY_PURGE_SECRET=

# OPTIONAL RUNTIME no-CI fallback: enable ONLY on hosts without the GitHub purge
# workflow. Requires runtime BUNNY_API_KEY + BUNNY_PULL_ZONE_ID, and waits for local
# readiness. Never enable alongside CI (one deploy-time purge trigger).
# BUNNY_PURGE_ON_START=false

# HOST/CI METADATA: normally injected, not values to copy between deployments.
# Tina branch precedence: GITHUB_BRANCH, VERCEL_GIT_COMMIT_REF, WORKERS_CI_BRANCH,
# CF_PAGES_BRANCH, HEAD (Netlify), COOLIFY_BRANCH, then main.
# URL/adapter detection: VERCEL, VERCEL_PROJECT_PRODUCTION_URL, VERCEL_URL,
# NETLIFY, URL, DEPLOY_PRIME_URL, DEPLOY_URL, CF_PAGES, WORKERS_CI, CF_PAGES_URL,
# COOLIFY_URL. Contact origins use SITE_URL, URL, DEPLOY_PRIME_URL, DEPLOY_URL,
# CF_PAGES_URL and COOLIFY_URL; add other preview URLs to CONTACT_ALLOWED_ORIGINS.
# Commit marker precedence: COMMIT_SHA, SOURCE_COMMIT, COMMIT_REF, GITHUB_SHA,
# then local Git. On Coolify enable "Include Source Commit in Build" to supply
# SOURCE_COMMIT; the Dockerfile forwards it. Other custom builders must inject
# an actual commit SHA before the build script runs, not hardcode one in .env.
